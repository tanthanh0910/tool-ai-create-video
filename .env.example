# Video Settings (kich thuoc do o "Ty le khung hinh" trong UI quyet dinh)
FPS=24

# TTS Settings (Edge TTS - mien phi)
TTS_VOICE=vi-VN-HoaiMyNeural

# Pexels API (free - dang ky tai https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_here

# Output
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ===== Dang video len YouTube / Facebook =====
# Bien BAT BUOC duy nhat. Local de nguyen; production doi thanh
# https://<ten mien cong khai> - khong cong, khong dau / o cuoi.
OAUTH_REDIRECT_BASE=http://localhost:5000

# Khoa ky state + ma hoa token. De trong thi tool tu sinh ra file .jwt_secret.
# DOI khoa nay = moi kenh phai ket noi lai.
JWT_SECRET=

# ===== AI viet tieu de / mo ta / tag (nut "AI viet gium") =====
# provider: anthropic | openai | gemini | aics
LLM_PROVIDER=anthropic
LLM_API_KEY=
# De trong = dung mac dinh cua provider (anthropic: claude-sonnet-5, openai: gpt-4o,
# gemini: gemini-2.5-flash). aics thi model do may chu chot.
LLM_MODEL=
# Doi khi can tro qua proxy / gateway noi bo
LLM_BASE_URL=
# So khung hinh trich cho AI nhin (4 la du, nhieu hon chi doi token anh)
LLM_FRAME_COUNT=4

# App he thong - DUONG LUI khi user chua khai app cua rieng minh. De trong cung chay.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
